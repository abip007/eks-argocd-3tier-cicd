# Settings for docs/02-command-line-guide.md. Load with:  source cli/config.env
# Values already exported in your shell win.
: "${AWS_PROFILE:=abip007home}"
: "${AWS_REGION:=ap-south-1}"
: "${NAME:=bmi-cicd}"                                   # prefix of every resource (keep: buildspec reads secret bmi-cicd/ci)
: "${CLUSTER:=bmi-cicd-eks}"                            # EKS cluster (eksctl/cluster.yaml has the same name)
: "${DOMAIN:=bestclick.click}"                          # Route 53 public hosted zone
: "${ARGOCD_HOST:=argocd-cicd.bestclick.click}"         # must equal platform/argocd-values.yaml
: "${APP_HOST:=cicd-bmi.bestclick.click}"               # must equal gitops/bmi-cicd/overlays/prod
: "${GITHUB_REPO:=abip007/eks-argocd-3tier-cicd}"       # owner/name of THIS repo
: "${GIT_BRANCH:=main}"
: "${SONAR_INSTANCE_TYPE:=m7i-flex.large}"              # >= 4 GiB RAM for SonarQube
export AWS_PROFILE AWS_REGION NAME CLUSTER DOMAIN ARGOCD_HOST APP_HOST GITHUB_REPO GIT_BRANCH SONAR_INSTANCE_TYPE

# Fills ${VARS} in cli/<file> and writes cli/.out/<file>. Only the listed
# variables are replaced, so '#{SourceVariables.CommitId}' etc. stay as they are.
render() {
  mkdir -p cli/.out
  envsubst '${AWS_REGION} ${ACCOUNT_ID} ${NAME} ${GITHUB_REPO} ${GIT_BRANCH} ${APP_HOST} ${SONAR_HOST_URL} ${CONNECTION_ARN} ${BUCKET}' \
    < "cli/$1" > "cli/.out/$1"
  echo "cli/.out/$1"
}

# Private Helm repo config/cache: a stale global Helm cache on Windows
# (%TEMP%\helm) otherwise breaks installs with "no cached repo found".
export HELM_REPOSITORY_CONFIG="$PWD/.helm/repositories.yaml" HELM_REPOSITORY_CACHE="$PWD/.helm/cache"
